# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Postgres connection string used by Prisma (prisma.config.ts reads this).
# Phase 0: no live database is configured yet — see docs/decisions.md for the
# local-Postgres deviation note. Point this at your local Postgres (or local
# Supabase, once the Supabase CLI is set up) before running `prisma migrate dev`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_gym_saas?schema=public"
