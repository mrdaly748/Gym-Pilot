# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# See docs/architecture.md §5.3a, §5.6, §9 and docs/decisions.md D16/D19/D20 for the
# reasoning behind every value below.

# --- Database (Postgres, via a hosted Supabase dev project once one exists) ---

# Pooled connection (Supabase Supavisor, transaction mode, port 6543).
# Used by the app's runtime Prisma client (@prisma/adapter-pg), connected as
# the dedicated, least-privilege `app_user` role (NOBYPASSRLS) — never the
# migration-owner role. Run prisma/sql/bootstrap-app-role.sql once per
# environment to create this role before using it here.
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/postgres?sslmode=require"

# Direct, non-pooled connection (port 5432). Used only by
# `prisma migrate dev`/`deploy`, connected as the migration-owner role
# (e.g. Supabase's default `postgres` role) — never `app_user`.
DIRECT_URL="postgresql://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=require"

# --- Supabase Auth ---

# Public — safe to expose to the browser. Only ever used for Auth operations
# (sign-in/out/session refresh), never for business-data queries (those go
# through Prisma, not PostgREST). See docs/architecture.md §3.
NEXT_PUBLIC_SUPABASE_URL="https://CHANGE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"

# Secret. NOT used in Phase 1 — its only planned use (provisioning Supabase
# Auth users when Platform Admin creates a gym) is Phase 2. Left unset here
# deliberately; do not wire it into any code path before it's actually needed.
# SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"
