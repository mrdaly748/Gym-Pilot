// Phase 1 schema: identity + tenancy foundation only.
// See docs/architecture.md §3 and §5 for the design this implements.
//
// Generated client lives under lib/server/ — this is intentional. Only
// lib/server/services/** and lib/server/db.ts may import from it (see
// docs/architecture.md §2 and the ESLint boundary rule in eslint.config.mjs).
generator client {
  provider = "prisma-client"
  output   = "../lib/server/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum GymStatus {
  ACTIVE
  SUSPENDED

  @@map("gym_status")
}

// Deliberately uppercase, matching docs/architecture.md §5.3's concrete
// set_config(...) examples exactly (e.g. 'PLATFORM_ADMIN') — see
// docs/decisions.md for the casing-consistency correction this follows.
enum MembershipRole {
  PLATFORM_ADMIN
  GYM_ADMIN
  GYM_STAFF

  @@map("membership_role")
}

model Gym {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    GymStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  memberships       GymMembership[]
  members           Member[]
  membershipPlans   MembershipPlan[]
  memberMemberships Membership[]
  membershipFreezes MembershipFreeze[]

  @@map("gyms")
}

// Mirrors the corresponding Supabase auth.users.id (id is NOT DB-generated
// here — it's assigned by the caller to match the Supabase Auth user).
// Deliberately not FK'd into the `auth` schema — see docs/architecture.md §3
// for why (shadow DB / CI plain-Postgres portability).
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  memberships GymMembership[]

  @@map("users")
}

// gymId is nullable only for PLATFORM_ADMIN rows. The pairing is enforced by
// a hand-authored CHECK constraint, and at most one PLATFORM_ADMIN row per
// user is enforced by a hand-authored partial unique index — neither is
// expressible in Prisma's schema DSL, so both live in
// prisma/migrations/*_rls_core/migration.sql alongside the RLS policies.
// See docs/architecture.md §3 and §5.3b.
model GymMembership {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  gymId      String?        @map("gym_id") @db.Uuid
  role       MembershipRole
  // Phase 2: set to disable a Gym Staff login without deleting the row
  // (deactivation != deletion, matching the gyms.status pattern). Checked
  // centrally in lib/server/auth.ts's getSessionContext(). Not used for
  // PLATFORM_ADMIN/GYM_ADMIN rows in Phase 2's UI.
  disabledAt DateTime?      @map("disabled_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([gymId])
  @@map("gym_memberships")
}

// Phase 3: business data, gym-scoped. Deliberately no Platform Admin RLS
// bypass on this table (see the RLS migration) — Platform Admin has no
// default access to gym operational data (docs/architecture.md §7).
//
// archivedAt is the Phase 3 record-level active/archived flag (same idiom
// as GymMembership.disabledAt) — NOT the membership-derived canonical
// status (active/expiring/expired/frozen/cancelled) from product-spec.md
// §13 Rule 1, which is Phase 4 scope once Memberships exist.
model Member {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId                 String    @map("gym_id") @db.Uuid
  name                  String
  phone                 String
  // Digits-only form of `phone` (strip everything non-digit), used for
  // deterministic duplicate detection — see lib/server/services/members.ts.
  phoneNormalized       String    @map("phone_normalized")
  joinDate              DateTime  @map("join_date") @db.Date
  // Minimal, optional — no medical/health data (product-spec.md §17).
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  archivedAt            DateTime? @map("archived_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@index([gymId])
  @@index([gymId, phoneNormalized])
  @@map("members")
}

// Phase 3: business data, gym-scoped. Same no-Platform-Admin-bypass rule as
// Member (see the RLS migration).
model MembershipPlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId         String    @map("gym_id") @db.Uuid
  name          String
  // Tunisian Dinar's smallest unit (1 TND = 1000 millimes) — integer, never
  // a float, to avoid rounding issues outright. 0 is valid (trial/promo
  // plans, product-spec.md §11.2).
  priceMillimes Int       @map("price_millimes")
  durationDays  Int       @map("duration_days")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@index([gymId])
  @@map("membership_plans")
}

// Phase 4: connects a Member to a MembershipPlan over time. Deliberately no
// stored status column (docs/architecture.md §5.5) — active/expiring
// soon/expired/frozen/cancelled is derived at query time by
// lib/server/services/metrics.ts from startDate/endDate/cancelledAt plus
// this membership's MembershipFreeze rows. Same no-Platform-Admin-bypass
// rule as Member/MembershipPlan (see the RLS migration).
//
// Plan terms are snapshotted at assignment time (name/price/duration) so a
// later edit to MembershipPlan can never retroactively change an
// already-sold membership's terms (product-spec.md §18) — `planId` is kept
// only for traceability back to the plan actually sold, never re-read for
// the membership's own terms.
model Membership {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId                 String    @map("gym_id") @db.Uuid
  memberId              String    @map("member_id") @db.Uuid
  planId                String    @map("plan_id") @db.Uuid
  planNameSnapshot       String   @map("plan_name_snapshot")
  priceMillimesSnapshot  Int      @map("price_millimes_snapshot")
  durationDaysSnapshot   Int      @map("duration_days_snapshot")
  startDate             DateTime  @db.Date @map("start_date")
  // Mutable — shifted forward by the frozen-day count each time a freeze
  // resumes (product-spec.md §13 Rule 6). Not a "status"; a fact about when
  // the membership's term actually ends.
  endDate               DateTime  @db.Date @map("end_date")
  // Gym-Admin-only manual early cancellation, distinct from natural
  // expiration (product-spec.md §13 Rule 7). A cancelled membership is
  // permanent — see the RLS migration's WITH CHECK for how Gym Staff is
  // blocked from ever setting or touching this.
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  gym     Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member  Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan    MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  freezes MembershipFreeze[]

  @@index([gymId])
  @@index([memberId])
  @@map("memberships")
}

// One row per freeze period (product-spec.md §13 Rule 6) — a dedicated
// table, not fields on Membership, so a membership's full freeze history
// survives repeated freeze/resume cycles without ambiguity about which
// period is "current." `resumedAt IS NULL` means still frozen.
model MembershipFreeze {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId        String    @map("gym_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  frozenAt     DateTime  @map("frozen_at")
  resumedAt    DateTime? @map("resumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([membershipId])
  @@map("membership_freezes")
}
