// Phase 1 schema: identity + tenancy foundation only.
// See docs/architecture.md §3 and §5 for the design this implements.
//
// Generated client lives under lib/server/ — this is intentional. Only
// lib/server/services/** and lib/server/db.ts may import from it (see
// docs/architecture.md §2 and the ESLint boundary rule in eslint.config.mjs).
generator client {
  provider = "prisma-client"
  output   = "../lib/server/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum GymStatus {
  ACTIVE
  SUSPENDED

  @@map("gym_status")
}

// Deliberately uppercase, matching docs/architecture.md §5.3's concrete
// set_config(...) examples exactly (e.g. 'PLATFORM_ADMIN') — see
// docs/decisions.md for the casing-consistency correction this follows.
enum MembershipRole {
  PLATFORM_ADMIN
  GYM_ADMIN
  GYM_STAFF

  @@map("membership_role")
}

model Gym {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    GymStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  memberships        GymMembership[]
  members            Member[]
  membershipPlans    MembershipPlan[]
  memberMemberships  Membership[]
  membershipFreezes  MembershipFreeze[]
  payments           Payment[]
  paymentAdjustments PaymentAdjustment[]
  attendanceCheckins AttendanceCheckin[]
  trainers           Trainer[]
  trainerMemberLinks TrainerMemberLink[]
  expenses           Expense[]
  expenseAdjustments ExpenseAdjustment[]
  aiUsageCounters    AiUsageCounter[]

  @@map("gyms")
}

// Mirrors the corresponding Supabase auth.users.id (id is NOT DB-generated
// here — it's assigned by the caller to match the Supabase Auth user).
// Deliberately not FK'd into the `auth` schema — see docs/architecture.md §3
// for why (shadow DB / CI plain-Postgres portability).
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  memberships         GymMembership[]
  paymentsRecorded    Payment[]           @relation("PaymentsRecorded")
  adjustmentsRecorded PaymentAdjustment[] @relation("PaymentAdjustmentsRecorded")
  attendanceCheckinsRecorded AttendanceCheckin[] @relation("AttendanceCheckinsRecorded")
  expensesRecorded           Expense[]           @relation("ExpensesRecorded")
  expenseAdjustmentsRecorded ExpenseAdjustment[] @relation("ExpenseAdjustmentsRecorded")

  @@map("users")
}

// gymId is nullable only for PLATFORM_ADMIN rows. The pairing is enforced by
// a hand-authored CHECK constraint, and at most one PLATFORM_ADMIN row per
// user is enforced by a hand-authored partial unique index — neither is
// expressible in Prisma's schema DSL, so both live in
// prisma/migrations/*_rls_core/migration.sql alongside the RLS policies.
// See docs/architecture.md §3 and §5.3b.
model GymMembership {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  gymId      String?        @map("gym_id") @db.Uuid
  role       MembershipRole
  // Phase 2: set to disable a Gym Staff login without deleting the row
  // (deactivation != deletion, matching the gyms.status pattern). Checked
  // centrally in lib/server/auth.ts's getSessionContext(). Not used for
  // PLATFORM_ADMIN/GYM_ADMIN rows in Phase 2's UI.
  disabledAt DateTime?      @map("disabled_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([gymId])
  @@map("gym_memberships")
}

// Phase 3: business data, gym-scoped. Deliberately no Platform Admin RLS
// bypass on this table (see the RLS migration) — Platform Admin has no
// default access to gym operational data (docs/architecture.md §7).
//
// archivedAt is the Phase 3 record-level active/archived flag (same idiom
// as GymMembership.disabledAt) — NOT the membership-derived canonical
// status (active/expiring/expired/frozen/cancelled) from product-spec.md
// §13 Rule 1, which is Phase 4 scope once Memberships exist.
model Member {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId                 String    @map("gym_id") @db.Uuid
  name                  String
  phone                 String
  // Digits-only form of `phone` (strip everything non-digit), used for
  // deterministic duplicate detection — see lib/server/services/members.ts.
  phoneNormalized       String    @map("phone_normalized")
  joinDate              DateTime  @map("join_date") @db.Date
  // Minimal, optional — no medical/health data (product-spec.md §17).
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  archivedAt            DateTime? @map("archived_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]
  attendanceCheckins AttendanceCheckin[]
  trainerLinks       TrainerMemberLink[]

  @@index([gymId])
  @@index([gymId, phoneNormalized])
  @@map("members")
}

// Phase 3: business data, gym-scoped. Same no-Platform-Admin-bypass rule as
// Member (see the RLS migration).
model MembershipPlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId         String    @map("gym_id") @db.Uuid
  name          String
  // Tunisian Dinar's smallest unit (1 TND = 1000 millimes) — integer, never
  // a float, to avoid rounding issues outright. 0 is valid (trial/promo
  // plans, product-spec.md §11.2).
  priceMillimes Int       @map("price_millimes")
  durationDays  Int       @map("duration_days")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@index([gymId])
  @@map("membership_plans")
}

// Phase 4: connects a Member to a MembershipPlan over time. Deliberately no
// stored status column (docs/architecture.md §5.5) — active/expiring
// soon/expired/frozen/cancelled is derived at query time by
// lib/server/services/metrics.ts from startDate/endDate/cancelledAt plus
// this membership's MembershipFreeze rows. Same no-Platform-Admin-bypass
// rule as Member/MembershipPlan (see the RLS migration).
//
// Plan terms are snapshotted at assignment time (name/price/duration) so a
// later edit to MembershipPlan can never retroactively change an
// already-sold membership's terms (product-spec.md §18) — `planId` is kept
// only for traceability back to the plan actually sold, never re-read for
// the membership's own terms.
model Membership {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId                 String    @map("gym_id") @db.Uuid
  memberId              String    @map("member_id") @db.Uuid
  planId                String    @map("plan_id") @db.Uuid
  planNameSnapshot       String   @map("plan_name_snapshot")
  priceMillimesSnapshot  Int      @map("price_millimes_snapshot")
  durationDaysSnapshot   Int      @map("duration_days_snapshot")
  startDate             DateTime  @db.Date @map("start_date")
  // Mutable — shifted forward by the frozen-day count each time a freeze
  // resumes (product-spec.md §13 Rule 6). Not a "status"; a fact about when
  // the membership's term actually ends.
  endDate               DateTime  @db.Date @map("end_date")
  // Gym-Admin-only manual early cancellation, distinct from natural
  // expiration (product-spec.md §13 Rule 7). A cancelled membership is
  // permanent — see the RLS migration's WITH CHECK for how Gym Staff is
  // blocked from ever setting or touching this.
  cancelledAt           DateTime? @map("cancelled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  gym      Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member   Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan     MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  freezes  MembershipFreeze[]
  payments Payment[]

  @@index([gymId])
  @@index([memberId])
  @@map("memberships")
}

// One row per freeze period (product-spec.md §13 Rule 6) — a dedicated
// table, not fields on Membership, so a membership's full freeze history
// survives repeated freeze/resume cycles without ambiguity about which
// period is "current." `resumedAt IS NULL` means still frozen.
model MembershipFreeze {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId        String    @map("gym_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  frozenAt     DateTime  @map("frozen_at")
  resumedAt    DateTime? @map("resumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([membershipId])
  @@map("membership_freezes")
}

// Phase 5: append-only (product-spec.md §13 Rule 11, architecture.md §5.7).
// Deliberately no `updatedAt` — this row has no update lifecycle at all
// (see the RLS migration: app_user gets SELECT+INSERT only, no UPDATE/
// DELETE grant, so mutation is impossible at the database layer, not just
// absent from the service layer). Corrections are PaymentAdjustment rows,
// never edits to this row. Same no-Platform-Admin-bypass rule as every
// other business table since Phase 3.
model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId          String   @map("gym_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  amountMillimes Int      @map("amount_millimes")
  method         String
  paidAt         DateTime @map("paid_at")
  // Audit trail (product-spec.md §11.4/§13 Rule 11): who recorded it, and
  // createdAt (below) is when.
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  gym         Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  membership  Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  recordedBy  User                @relation("PaymentsRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  adjustments PaymentAdjustment[]

  @@index([gymId])
  @@index([membershipId])
  @@map("payments")
}

// One row per correction (product-spec.md §13 Rule 11) — `amountMillimes`
// is a signed delta against the original payment's effective amount, never
// a replacement value; a full void is `-` the payment's current effective
// amount. Same append-only design as Payment: no `updatedAt`, no
// UPDATE/DELETE grant.
model PaymentAdjustment {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId          String  @map("gym_id") @db.Uuid
  paymentId      String  @map("payment_id") @db.Uuid
  amountMillimes Int     @map("amount_millimes")
  reason         String?
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  gym        Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentAdjustmentsRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([paymentId])
  @@map("payment_adjustments")
}

// Phase 6: attendance check-ins (product-spec.md §11.5, §13 Rule 10).
// Deliberately targets Member, not Membership — attendance is conceptually
// independent of membership/payment status (product-spec.md §18: a check-in
// must be recorded even when the member's membership is expired/frozen/
// cancelled/nonexistent; the current status is surfaced by the service
// layer via metrics.ts's deriveMembershipStatus(), never blocking here).
//
// Unlike Payment/PaymentAdjustment, this is NOT append-only: Rule 11's
// insert-only regime is scoped to payments/expenses only. A Gym-Admin-only
// correction path (UPDATE/DELETE) exists — see the Phase 6 migration's
// grants/RLS. `checkedInAt` is always server-stamped "now" (no backdating
// in spec), so there's no separate business-date-vs-recorded-at pair like
// Payment.paidAt/createdAt.
model AttendanceCheckin {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId            String   @map("gym_id") @db.Uuid
  memberId         String   @map("member_id") @db.Uuid
  checkedInAt      DateTime @default(now()) @map("checked_in_at")
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid

  gym        Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy User   @relation("AttendanceCheckinsRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, checkedInAt])
  @@map("attendance_checkins")
}

// Phase 7: trainer directory (product-spec.md §11.6). Gym-Admin-only at
// every access level (SELECT/INSERT/UPDATE), not merely UI-hidden — the
// first fully Gym-Admin-only table in the project; Gym Staff has zero
// access, unlike members/membership_plans where Staff at least gets SELECT.
// Same archive-not-delete idiom as Member/MembershipPlan (product-spec.md
// §13 Rule 12): archivedAt hides a trainer from new selections/assignments
// while every existing TrainerMemberLink survives untouched, preserved for
// historical reporting.
model Trainer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId        String    @map("gym_id") @db.Uuid
  name         String
  contactPhone String?   @map("contact_phone")
  contactEmail String?   @map("contact_email")
  specialty    String?
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  gym   Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  links TrainerMemberLink[]

  @@index([gymId])
  @@map("trainers")
}

// Many-to-many trainer<->member association (product-spec.md §11.6: "one or
// more members" per trainer; nothing in the spec restricts a member to a
// single trainer, so this is a genuine join table, not a trainerId column
// on Member). gymId is denormalized onto this row (not derived by joining
// through Trainer/Member) so RLS can scope it directly — same reasoning as
// Payment/AttendanceCheckin carrying gymId. The unique constraint on
// (trainerId, memberId) prevents a duplicate link at the database layer,
// not merely an application-level check.
model TrainerMemberLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId     String   @map("gym_id") @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([trainerId, memberId])
  @@index([gymId])
  @@index([trainerId])
  @@index([memberId])
  @@map("trainer_member_links")
}

// Phase 7: append-only, exactly like Payment (product-spec.md §13 Rule 11
// explicitly groups "payments and expenses" under the same insert-only,
// adjustment-based correction regime — the informal "edit/archive" wording
// in spec §11.7 is superseded by Rule 11's canonical, explicit rule; see
// docs/decisions.md's Phase 7 entry). Deliberately no `updatedAt` — same
// no-update-lifecycle design as Payment: app_user gets SELECT+INSERT only,
// no UPDATE/DELETE grant. Corrections are ExpenseAdjustment rows, never
// edits to this row. Gym-Admin-only at every access level (unlike Payment,
// where Gym Staff can record/read) — Gym Staff has zero access to expense
// data (product-spec.md §11.7: "Gym Staff do not record or view expenses").
model Expense {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId            String   @map("gym_id") @db.Uuid
  category         String
  amountMillimes   Int      @map("amount_millimes")
  expenseDate      DateTime @map("expense_date") @db.Date
  note             String?
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  gym         Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  recordedBy  User                @relation("ExpensesRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  adjustments ExpenseAdjustment[]

  @@index([gymId])
  @@index([gymId, expenseDate])
  @@map("expenses")
}

// One row per correction (product-spec.md §13 Rule 11) — `amountMillimes`
// is a signed delta against the original expense's effective amount, never
// a replacement value; a full void is `-` the expense's current effective
// amount. Same append-only design as PaymentAdjustment: no `updatedAt`, no
// UPDATE/DELETE grant. Gym-Admin-only (both recording an expense and
// creating an adjustment are Gym-Admin-only in Phase 7 — unlike Payments,
// there is no "Staff can record, Admin can adjust" split here).
model ExpenseAdjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId            String   @map("gym_id") @db.Uuid
  expenseId        String   @map("expense_id") @db.Uuid
  amountMillimes   Int      @map("amount_millimes")
  reason           String?
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  gym        Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("ExpenseAdjustmentsRecorded", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([expenseId])
  @@map("expense_adjustments")
}

// Phase 9: AI usage limiting (docs/architecture.md §6.7) — one row per
// gym per calendar day, incremented on every AI request before the model
// is invoked. Deliberately no reset job/cron/queue: a new day simply has
// no row yet, so "reset" is free (product-spec.md's own no-scheduler
// convention, same as membership status derivation, D8). Gym-Admin-only
// (matches the AI assistant's own access scope, D9) — no Gym Staff
// access, no Platform Admin bypass.
model AiUsageCounter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gymId     String   @map("gym_id") @db.Uuid
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@unique([gymId, date])
  @@index([gymId])
  @@map("ai_usage_counters")
}
